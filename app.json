{
  "expo": {
    "name": "Rally Up",
    "slug": "setmatch-app",
    "version": "1.0.0",
    "scheme": "setmatch",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#255943",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#255943"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fabricaapps.setmatch",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Rally Up uses your photo library so you can choose a profile picture on Edit Profile, or attach a photo to a post on Home.",
        "NSPhotoLibraryAddUsageDescription": "Rally Up uses your photo library so you can choose a profile picture on Edit Profile, or attach a photo to a post on Home."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#255943"
      },
      "package": "com.fabricaapps.setmatch",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "setmatch"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Rally Up",
      "shortName": "Rally Up",
      "description": "Desafios, rankings, aulas e torneios — tênis, padel, raquetinha e beach",
      "themeColor": "#255943",
      "backgroundColor": "#255943",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rally Up uses your photo library so you can choose a profile picture on Edit Profile, or attach a photo to a post on Home."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Rally Up usa sua localização para mostrar jogadores e quadras perto de você."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43b2727b-ab89-41a3-ad66-1973318dc57b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/43b2727b-ab89-41a3-ad66-1973318dc57b"
    }
  }
}
